PORT=3001
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=nurse_rota
DB_USER=nurseapp
DB_PASSWORD=your_db_password_here
JWT_SECRET=replace_with_long_random_secret_here
ALLOWED_ORIGIN=https://nrota.iwosanhealth.com

# UAT instance uses:
#   PORT=3002
#   DB_NAME=nurse_rota_uat
#   DB_USER=nurseapp_uat

# Email notifications (Microsoft Graph, app-only OAuth2) — see lib/mailer.js.
# Azure AD app registration needs Mail.Send (Application permission, admin
# consented). If any of these are unset, emails are logged instead of sent —
# nothing breaks, they just won't go out.
MS_GRAPH_TENANT_ID=
MS_GRAPH_CLIENT_ID=
MS_GRAPH_CLIENT_SECRET=
# Shared/service mailbox to send from — recommended over a personal mailbox.
MS_GRAPH_SENDER_EMAIL=notifications@iwosanhealth.com
# Base URL used to build the "Open Portal" links in emails.
PORTAL_BASE_URL=https://nrota.iwosanhealth.com
